# Variabili lette davvero dal frontend (Vite le compila dentro il bundle).
#
# ATTENZIONE: tutto ciò che metti qui finisce nel JavaScript pubblico. Qui
# dentro non va nessun segreto: solo URL pubblici, chiavi fatte per il browser
# (Google Maps, client id OAuth) e, per ora, le credenziali dell'account demo,
# che sono pubbliche per scelta (vedi docs/SICUREZZA.md).
#
# `backend/tests/unit/test_env_contract.py` fallisce se il codice legge un
# VITE_* che qui non c'è, o se qui c'è un VITE_* che nessuno legge.

# ========== API ==========
# In locale il backend gira sulla 8000; in produzione Render.
VITE_BACKEND_URL=http://localhost:8000

# ========== GOOGLE ==========
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_KEY=

# ========== ACCOUNT DEMO (pulsanti "Demo farmacia" e "Demo fattorino") ==========
# Sono credenziali di un tenant isolato, usate per far provare l'app a chi
# arriva dalla landing. Se restano vuote valgono i valori scritti nel codice.
VITE_DEMO_PHARMACY_EMAIL=
VITE_DEMO_PHARMACY_PASSWORD=
VITE_DEMO_DRIVER_EMAIL=
VITE_DEMO_DRIVER_PASSWORD=
