# Variabili lette davvero dal backend.
#
# Questo file non è decorativo: `backend/tests/unit/test_env_contract.py`
# fallisce se il codice legge una variabile che qui non c'è, e se qui c'è una
# variabile che nessuno legge. Se aggiungi una os.environ.get(...) nel codice,
# aggiungila anche qui, altrimenti la CI è rossa.
#
# Copia in `backend/.env` per lo sviluppo locale. Non committare mai il .env.

# ========== DATABASE (obbligatorie) ==========
# Senza queste due il backend non parte: il codice le legge con os.environ[...]
# e non hanno default. In produzione la stringa sta su Render -> pharmatrack-api
# -> Environment; in locale puoi usare un Mongo vuoto, i test unitari non lo aprono.
MONGO_URL=mongodb://localhost:27017
DB_NAME=pharmatrack

# ========== CONSOLE SUPER ADMIN ==========
# ADMIN_* è la coppia usata dal login della console; SUPERADMIN_* sono i vecchi
# nomi, accettati come ripiego. In produzione la password vera sta solo su Render.
ADMIN_EMAIL=admin@pharmatrack.app
ADMIN_PASSWORD=cambiami
ADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=
# Secondo fattore della console admin: segreto TOTP e casella che riceve il codice.
# Se ADMIN_TOTP_SECRET è vuoto il 2FA è spento.
ADMIN_TOTP_SECRET=
ADMIN_2FA_EMAIL=

# ========== URL PUBBLICI ==========
# APP_BASE_URL serve ai link nelle email; API_PUBLIC_URL all'hosting delle foto
# e ai link del bridge. In produzione le mette Render da sola
# (RENDER_EXTERNAL_URL è il ripiego automatico).
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
# In produzione la mette Render da sola; serve se API_PUBLIC_URL manca.
RENDER_EXTERNAL_URL=

# ========== CORS E ORIGINI AMMESSE ==========
# Elenco separato da virgole. È anche l'elenco usato dalla difesa CSRF: una
# richiesta che modifica dati e arriva da un Origin fuori da qui viene rifiutata.
CORS_ORIGINS=http://localhost:3000

# ========== AMBIENTE ==========
# "production" spegne /api/docs, /api/redoc e /api/openapi.json. In locale
# lascialo vuoto o "development".
ENVIRONMENT=development

# ========== SESSIONI E LIMITI (formato lente/cadenza) ==========
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=3/minute
FORGOT_RATE_LIMIT=3/minute
# Tentativi consentiti per minuto nel controllo del token di reset password.
RESET_RATE_LIMIT=5/minute
PUBLIC_WRITE_RATE_LIMIT=20/minute
CSP_REPORT_RATE_LIMIT=60/minute
CACHE_TTL_SECONDS=60

# ========== EMAIL (Brevo) ==========
# Porta 587 con STARTTLS (SMTP_USE_TLS=true) oppure 465 con SSL.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Deve essere un mittente validato in Brevo: se non lo e', Brevo accetta l'invio
# (201) e poi scarta il messaggio, quindi nessuna email arriva e nessun errore appare.
# Oggi l'unico validato e' federicomellino@gmail.com; noreply@pharmatrack.app
# funzionera' solo dopo l'autenticazione del dominio in Brevo (record DNS).
SMTP_FROM=federicomellino@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Casella che riceve gli allarmi automatici. Se vuota, gli allarmi non partono.
ALERT_EMAIL=

# ========== GOOGLE ==========
# Client OAuth del pulsante "Accedi con Google" e chiavi per geocoding e mappe.
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_API_KEY=
# Ripiego storico: il backend accetta il client id anche col nome del frontend.
VITE_GOOGLE_CLIENT_ID=

# ========== NOTIFICHE PUSH (WebPush VAPID) ==========
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@pharmatrack.app

# ========== FOTO DELLE CONSEGNE (Cloudinary) ==========
# Senza queste tre, le foto vanno su disco (LOCAL_PHOTO_STORAGE=1) e su Render
# si perdono al riavvio.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOCAL_PHOTO_STORAGE=1

# ========== SENTRY ==========
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ========== ACCOUNT DEMO ==========
# L'email identifica il tenant demo; la password non serve, la sessione la apre
# il server (app/routers/demo.py) e nessuna credenziale finisce nel frontend.
# Se cambi questi account, cambiali qui o su Render, non nel frontend.
DEMO_PHARMACY_EMAIL=test@farmaciaprova.it
DEMO_DRIVER_EMAIL=luca@fattorino.it

# ========== OPZIONALI ==========
# Cache: se REDIS_URL non c'è, si usa la cache in memoria del processo.
REDIS_URL=
